APP_ENV=development
APP_URL=http://localhost:3000
# Generate a random 32+ character value; keep it stable across workers/restarts.
AUTH_SECRET=
OWNER_SESSION_TTL_SECONDS=43200
REVIEW_SESSION_TTL_SECONDS=7200
# Supabase Dashboard > Connect > Session pooler (5432) or Direct connection.
# URL-encode special characters in the database password.
# No browser publishable key or service-role key is needed for SQL access.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full
# Optional separate migration credential; defaults to DATABASE_URL in development.
MIGRATION_DATABASE_URL=
# Optional Supabase CA certificate file if the host requires it.
DATABASE_SSL_ROOT_CERT=
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=5000
# Anthropic generation is backend-only. Set false to use the local template provider.
GENERATION_ENABLED=true
AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-4-5-20251001
AI_API_KEY=
AI_TIMEOUT_SECONDS=6
BUSINESS_DAILY_GENERATION_LIMIT=300
